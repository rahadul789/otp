COMPOSE_PROJECT_NAME=foodbela

# Public ports used by Caddy. Keep these as 80/443 for normal HTTP/HTTPS traffic.
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=admin@foodbela.com

# Monitoring UI ports are bound to localhost by default.
# Use SSH tunnel for production access, or change to 0.0.0.0 only behind firewall/auth.
MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_PORT=12345
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_AUTH_TOKEN=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# MongoDB Atlas connection string. URL-encode special characters in username/password.
MONGODB_URI=mongodb+srv://ATLAS_USERNAME:ATLAS_PASSWORD@ATLAS_CLUSTER_HOST/foodbela?retryWrites=true&w=majority

WEBSITE_BASE_URL=https://foodbela.com
BACKEND_API_BASE_URL=http://backend:5000/api/v1

CLIENT_ORIGIN=https://owner.foodbela.com
ADMIN_PANEL_ORIGIN=https://admin.foodbela.com
CUSTOMER_APP=https://foodbela.com
DELIVERY_APP=https://foodbela.com
BACKEND_PUBLIC_URL=https://api.foodbela.com

JWT_ACCESS_SECRET=change_this_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_this_with_openssl_rand_hex_32

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d

ADMIN_BOOTSTRAP_EMAIL=admin@foodbela.com
ADMIN_BOOTSTRAP_PASSWORD=change_this_admin_password
ADMIN_BOOTSTRAP_NAME=Foodbela Admin
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_AUTH_COOKIE_SECURE=true
ADMIN_AUTH_COOKIE_SAME_SITE=lax
OWNER_AUTH_COOKIE_SECURE=true
OWNER_AUTH_COOKIE_SAME_SITE=lax



CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

MOCK_OTP_ENABLED=false
MOCK_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_API_URL=https://api.sms.net.bd/sendsms
SMS_API_KEY=your_smsbd_api_key
SMS_SENDER_ID=

# Operational alerts. Email uses Hostinger SMTP. Telegram is optional.
ALERTS_ENABLED=false
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=30
ALERT_RECIPIENT_EMAILS=admin@foodbela.com
ALERT_FROM_EMAIL=alerts@foodbela.com
ALERT_FROM_NAME=Foodbela Monitor
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerts@foodbela.com
SMTP_PASS=your_hostinger_email_password
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_SYSTEM_BOT_TOKEN=
TELEGRAM_SYSTEM_CHAT_ID=
ALERT_BACKEND_HEALTH_URL=https://api.foodbela.com/api/v1/health/ready
ALERT_METRICS_URL=http://backend:5000/metrics
ALERT_SSL_HOSTS=foodbela.com,www.foodbela.com,api.foodbela.com,owner.foodbela.com,admin.foodbela.com
ALERT_SSL_EXPIRY_DAYS=14
ALERT_MEMORY_RSS_MB=900
ALERT_CPU_PERCENT=85
ALERT_5XX_THRESHOLD=5
ALERT_SMS_LOW_BALANCE=100
ALERT_REFUND_PENDING_MINUTES=120
ALERT_SUPPORT_SLA_OVERDUE_MINUTES=15

# Browser will call the same app subdomain, then Caddy proxies /api and /socket.io to backend.
OWNER_VITE_API_BASE_URL=/api/v1
ADMIN_VITE_API_BASE_URL=/api/v1
VITE_ENABLE_ADMIN_BOOTSTRAP=false
