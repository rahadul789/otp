COMPOSE_PROJECT_NAME=foodbela

# Public web port on the VPS. Keep 80 for normal HTTP traffic.
WEB_PORT=80

# Monitoring UI ports are bound to localhost by default.
# Use SSH tunnel for production access, or change to 0.0.0.0 only behind firewall/auth.
MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_PORT=12345
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_AUTH_TOKEN=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# MongoDB Atlas connection string. URL-encode special characters in username/password.
MONGODB_URI=mongodb+srv://ATLAS_USERNAME:ATLAS_PASSWORD@ATLAS_CLUSTER_HOST/foodbela?retryWrites=true&w=majority

# Use http://72.60.219.174 first. After domain/SSL, change these to https://your-domain.com.
CLIENT_ORIGIN=http://72.60.219.174
ADMIN_PANEL_ORIGIN=http://72.60.219.174
CUSTOMER_APP=http://72.60.219.174
DELIVERY_APP=http://72.60.219.174
BACKEND_PUBLIC_URL=http://72.60.219.174

JWT_ACCESS_SECRET=change_this_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_this_with_openssl_rand_hex_32

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d

ADMIN_BOOTSTRAP_EMAIL=admin@foodbela.com
ADMIN_BOOTSTRAP_PASSWORD=change_this_admin_password
ADMIN_BOOTSTRAP_NAME=Foodbela Admin
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_AUTH_COOKIE_SECURE=false
ADMIN_AUTH_COOKIE_SAME_SITE=lax
OWNER_AUTH_COOKIE_SECURE=false
OWNER_AUTH_COOKIE_SAME_SITE=lax



CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

MOCK_OTP_ENABLED=false
MOCK_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_API_URL=https://api.sms.net.bd/sendsms
SMS_API_KEY=your_smsbd_api_key
SMS_SENDER_ID=

# Browser will call the same nginx host, then nginx proxies /api to backend.
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_ADMIN_BOOTSTRAP=false
