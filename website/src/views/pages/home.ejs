          </div>
          <div class="mobile-dashboard-wave"></div>
        </div>
      </div>
    </div>
    <div class="step-block" data-color="#F3FFF8" data-img="img3">
      <h2 data-i18n="stepThreeTitle">৩. সুপারফাস্ট ডেলিভারি 🚀</h2>
      <p data-i18n="stepThreeCopy">রাইডার পিকআপ থেকে দরজায় পৌঁছে দেওয়া পর্যন্ত পরিষ্কার নির্দেশনা পায়, আর কাস্টমার লাইভ ট্র্যাকিংয়ে পুরো অর্ডার জার্নি দেখতে পারে।</p>
      <div class="step-mobile-visual step-mobile-delivery" aria-hidden="true">
        <div class="mobile-delivery-shell">
          <span class="mobile-delivery-pin pickup"></span>
          <span class="mobile-delivery-pin dropoff"></span>
          <i></i>
          <b>🛵</b>
          <strong>Rider on route</strong>
        </div>
      </div>
    </div>
  </div>

  <div class="scroll-visual">
    <div class="visual-wrapper">
      <div class="visual-glow" aria-hidden="true"></div>
      <div id="img1" class="magic-img magic-device-scene qr-phone-scene active">
        <div class="scene-phone">
          <div class="phone-notch"></div>
          <div class="scene-phone-screen">
