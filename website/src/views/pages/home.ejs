  <div class="floating-food-scene" aria-hidden="true">
    <div class="scene-layer is-active" data-scene="img1">
      <span class="float-item item-a">🍕</span>
      <span class="float-item item-b">🍔</span>
      <span class="float-item item-c">🍟</span>
      <span class="float-item item-d">🌮</span>
      <span class="float-item item-e">🍩</span>
      <span class="float-item item-f">🥤</span>
      <span class="float-item item-g">🍣</span>
      <span class="float-item item-h">🥗</span>
