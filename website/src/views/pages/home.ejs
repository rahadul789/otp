  </div>

  <div class="scroll-texts">
    <div class="step-block active" data-color="#FFF3CF" data-img="img1">
      <h2 data-i18n="stepOneTitle">১. আপনার ক্রেভিং খুঁজুন 🍔</h2>
      <p data-i18n="stepOneCopy">শহরের সেরা রেস্টুরেন্ট, হাজারো মেন্যু, লোকাল অফার এবং পছন্দের খাবার মাত্র কয়েক ক্লিকে আপনার হাতের মুঠোয়।</p>
      <div class="step-mobile-visual step-mobile-qr" aria-hidden="true">
        <div class="mobile-visual-phone">
          <span class="mobile-visual-pill">Foodbela app</span>
