<%- include("../partials/document-start", { title, description }) %>

<%
  const appInstallUrl = websiteSettings.playStoreUrl || websiteSettings.appDownloadUrl || "/download";
  const appInstallIsExternal = appInstallUrl.startsWith("http");
  const qrInstallTarget = appInstallUrl.startsWith("http") ? appInstallUrl : `https://foodbela.com${appInstallUrl}`;
  const qrInstallUrl = encodeURIComponent(qrInstallTarget);
  const coverageRewardAmount = Number(websiteSettings.coverageRewardAmount || 2000).toLocaleString("en-US");
%>

<section class="hero">
  <div class="hero-live-layer" aria-hidden="true">
    <div class="hero-route-line">
      <span class="hero-flow-packet"></span>
    </div>
    <div class="hero-flow-popups">
      <div class="hero-status-popup popup-order">
        <small data-i18n="heroPopupOrderSmall">মোবাইল অ্যাপ</small>
        <strong data-i18n="heroPopupOrderTitle">অর্ডার প্লেসড</strong>
      </div>
      <div class="hero-status-popup popup-accepted">
        <small data-i18n="heroPopupAcceptedSmall">রেস্টুরেন্ট</small>
        <strong data-i18n="heroPopupAcceptedTitle">অর্ডার গ্রহণ</strong>
      </div>
      <div class="hero-status-popup popup-preparing">
        <small data-i18n="heroPopupPreparingSmall">কিচেন</small>
        <strong data-i18n="heroPopupPreparingTitle">রান্না চলছে</strong>
      </div>
      <div class="hero-status-popup popup-ready">
        <small data-i18n="heroPopupReadySmall">কিচেন</small>
        <strong data-i18n="heroPopupReadyTitle">পিকআপের জন্য প্রস্তুত</strong>
      </div>
      <div class="hero-status-popup popup-pickup">
        <small data-i18n="heroPopupPickupSmall">রাইডার</small>
        <strong data-i18n="heroPopupPickupTitle">পিকআপ সম্পন্ন</strong>
      </div>
      <div class="hero-status-popup popup-delivered">
        <small data-i18n="heroPopupDeliveredSmall">কাস্টমার</small>
        <strong data-i18n="heroPopupDeliveredTitle">ডেলিভারি সম্পন্ন</strong>
      </div>
    </div>
    <div class="hero-signal-card signal-order">
      <span class="signal-dot"></span>
      <small data-i18n="heroLiveOrderLabel">লাইভ অর্ডার</small>
      <strong data-i18n="heroLiveOrderText">মোবাইল থেকে অর্ডার প্লেস হচ্ছে</strong>
    </div>
    <div class="hero-signal-card signal-kitchen">
      <span class="signal-dot"></span>
      <small data-i18n="heroKitchenLabel">পার্টনার কিচেন</small>
      <strong data-i18n="heroKitchenText">গ্রহণ → রান্না → প্রস্তুত</strong>
      <div class="signal-step-row">
        <span data-i18n="heroKitchenStepOne">গ্রহণ</span>
        <span data-i18n="heroKitchenStepTwo">রান্না</span>
        <span data-i18n="heroKitchenStepThree">প্রস্তুত</span>
      </div>
    </div>
    <div class="hero-signal-card signal-rider">
      <span class="signal-dot"></span>
      <small data-i18n="heroRiderLabel">রাইডার আপডেট</small>
      <strong data-i18n="heroRiderText">পিকআপ → পথে → ডেলিভারড</strong>
    </div>
    <div class="hero-phone-preview">
      <div class="phone-topbar"></div>
      <div class="phone-brand">Foodbela</div>
      <div class="phone-food-card">
        <span>🍔</span>
        <div>
          <strong data-i18n="heroPhoneTitle">ক্রেভিং ম্যাচড</strong>
          <small data-i18n="heroPhoneCopy">আপনার এলাকার রেস্টুরেন্ট</small>
        </div>
      </div>
      <div class="phone-status-stack">
        <span class="phone-status phone-status-order" data-i18n="heroPhoneStatusOrder">অর্ডার প্লেসড</span>
        <span class="phone-status phone-status-delivered" data-i18n="heroPhoneStatusDelivered">ডেলিভারি সম্পন্ন</span>
      </div>
      <div class="phone-progress">
        <span></span>
      </div>
      <div class="phone-map-chip" data-i18n="heroPhoneChip">রাইডার পথে</div>
    </div>
  </div>
  <div class="hero-content">
    <p class="hero-kicker gs-up" data-i18n="heroKicker">আপনার শহরের ফুড ডেলিভারি নেটওয়ার্ক</p>
    <h1 class="gs-up" data-i18n-admin data-bn-text="<%= websiteSettings.heroTitle %>" data-en-text="<%= websiteSettings.heroTitleEn || 'Order food, grow restaurants, and power riders with Foodbela.' %>"><%= websiteSettings.heroTitle %></h1>
    <p class="gs-up" data-admin-hero-copy data-i18n-admin data-bn-text="<%= websiteSettings.heroSubtitle %>" data-en-text="<%= websiteSettings.heroSubtitleEn || 'Your local favorites, live tracking, and fast delivery in one app.' %>"><%= websiteSettings.heroSubtitle %></p>
  </div>
  <div class="lifecycle-demo is-playing" aria-label="Foodbela অর্ডার লাইফসাইকেল ডেমো">
    <div class="lifecycle-grid" aria-hidden="true"></div>
    <svg class="lifecycle-route-svg" viewBox="0 0 1000 520" aria-hidden="true" preserveAspectRatio="none">
      <path class="flow-path path-order" d="M150 282 C248 148 386 146 500 244" />
      <path class="flow-path path-package" d="M500 244 C614 146 752 148 860 282" />
      <path class="flow-path path-delivery" d="M860 332 C724 494 378 502 150 332" />
    </svg>
    <div class="lifecycle-route route-customer-restaurant" aria-hidden="true">
      <span class="route-pulse route-pulse-order"></span>
    </div>
    <div class="lifecycle-route route-restaurant-rider" aria-hidden="true">
      <span class="route-package">📦</span>
    </div>
    <div class="lifecycle-route route-rider-customer" aria-hidden="true"></div>

    <article class="lifecycle-device lifecycle-phone customer-preview">
      <div class="device-topbar"></div>
      <div class="device-brand">Foodbela</div>
      <div class="food-ticket">
        <span class="food-emoji">🍔</span>
        <div>
          <strong data-i18n="lifeCustomerMeal">বার্গার কম্বো</strong>
          <small data-i18n="lifeCustomerStore">Haor Bangla Kitchen</small>
        </div>
      </div>
      <button class="order-tap" type="button" tabindex="-1" data-i18n="lifeCustomerButton">অর্ডার করুন</button>
      <div class="device-status-stack">
        <span class="device-status status-customer-start" data-i18n="lifeCustomerStart">খাবার সিলেক্টেড</span>
        <span class="device-status status-customer-placed" data-i18n="lifeCustomerPlaced">অর্ডার প্লেসড</span>
        <span class="device-status status-customer-delivered" data-i18n="lifeCustomerDelivered">ডেলিভারড</span>
      </div>
      <div class="device-pop device-pop-customer" data-i18n="lifePopOrder">অর্ডার প্লেসড</div>
    </article>

    <article class="lifecycle-device restaurant-preview">
      <div class="restaurant-browser-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <b data-i18n="lifeRestaurantPanel">রেস্টুরেন্ট প্যানেল</b>
      </div>
      <div class="restaurant-panel-body">
        <aside class="restaurant-side">
          <strong data-i18n="lifeRestaurantStore">Haor Bangla Kitchen</strong>
          <span data-i18n="lifeRestaurantLive">লাইভ</span>
          <small data-i18n="lifeRestaurantQueue">৩টি অর্ডার চলছে</small>
        </aside>
        <main class="restaurant-main">
          <div class="restaurant-head">
            <span class="restaurant-dot"></span>
            <div>
              <small data-i18n="lifeRestaurantSmall">রেস্টুরেন্ট প্যানেল</small>
              <strong data-i18n="lifeRestaurantTitle">নতুন অর্ডার এসেছে</strong>
            </div>
          </div>
          <div class="restaurant-order-card">
            <div>
              <small>#FB-2048</small>
              <strong data-i18n="lifeRestaurantItem">বার্গার কম্বো × ১</strong>
            </div>
            <span data-i18n="lifeRestaurantEta">১৮ মিনিট</span>
          </div>
          <div class="restaurant-step-list">
            <span class="restaurant-step step-accepted" data-i18n="lifeAccepted">গ্রহণ</span>
            <span class="restaurant-step step-preparing" data-i18n="lifePreparing">রান্না চলছে</span>
            <span class="restaurant-step step-ready" data-i18n="lifeReady">প্রস্তুত</span>
          </div>
        </main>
      </div>
      <div class="device-pop device-pop-accepted" data-i18n="lifePopAccepted">গ্রহণ করা হয়েছে</div>
      <div class="device-pop device-pop-preparing" data-i18n="lifePopPreparing">রান্না চলছে</div>
      <div class="device-pop device-pop-ready" data-i18n="lifePopReady">পিকআপের জন্য প্রস্তুত</div>
      <div class="device-pop device-pop-earning"><strong data-i18n="lifeRestaurantEarning">+750tk</strong></div>
    </article>

    <article class="lifecycle-device lifecycle-phone rider-preview">
      <div class="device-topbar"></div>
      <div class="device-brand" data-i18n="lifeRiderBrand">রাইডার অ্যাপ</div>
      <div class="rider-map">
        <span class="map-node node-pickup"></span>
        <span class="map-node node-drop"></span>
        <i></i>
        <b><img class="rider-bike-symbol" src="/images/foodbela-icon.png" alt="" loading="lazy" /></b>
      </div>
      <div class="device-status-stack rider-status-stack">
        <span class="device-status status-rider-wait" data-i18n="lifeRiderWait">রেডি অর্ডার পাওয়া গেছে</span>
        <span class="device-status status-rider-pickup" data-i18n="lifeRiderPickup">পিকআপ হয়েছে</span>
        <span class="device-status status-rider-going" data-i18n="lifeRiderGoing">রাইডার পথে</span>
      </div>
      <div class="device-pop device-pop-pickup" data-i18n="lifePopPickup">পিকআপ হয়েছে</div>
      <div class="device-pop device-pop-rider-route" data-i18n="lifePopRiderRoute">রাইডার পথে</div>
    </article>

    <div class="delivery-rider" aria-hidden="true">
      <img class="delivery-rider-symbol" src="/images/foodbela-icon.png" alt="" loading="lazy" />
    </div>
    <div class="lifecycle-complete" data-i18n="lifeComplete">কাস্টমারের কাছে ডেলিভারড</div>
  </div>
</section>

<section class="coverage-section gs-fade" id="coverage">
  <div class="coverage-shell">
    <div class="coverage-copy">
      <p class="eyebrow" data-i18n="coverageEyebrow">সার্ভিস কভারেজ</p>
      <h2 data-i18n="coverageTitle">Foodbela কোন এলাকায় কাজ করছে?</h2>
    </div>
    <div class="coverage-area-list">
      <% (websiteSettings.serviceAreas || []).forEach((area) => { %>
        <% const areaSlug = String(area.name || "").trim().toLowerCase().replace(/&/g, " and ").replace(/[^a-z0-9\u0980-\u09FF]+/g, "-").replace(/^-+|-+$/g, ""); %>
        <a class="area-chip area-<%= area.status %>" href="/areas/<%= areaSlug %>-food-delivery">
          <strong><%= area.name %></strong>
          <small><%= area.status === "active" ? "Live" : area.status === "coming_soon" ? "Soon" : "Paused" %></small>
        </a>
      <% }) %>
    </div>
    <div class="coverage-request-card">
      <div>
        <div class="coverage-request-title">
          <strong data-i18n="coverageRequestTitle">আপনার এলাকায় Foodbela চান?</strong>
          <details class="coverage-info">
            <summary aria-label="Coverage request details">i</summary>
            <p data-i18n="coverageInfoCopy">এই request থেকে আমরা বুঝি কোন এলাকায় customer, restaurant partner এবং rider interest বেশি। টিম coverage planning করার সময় এই request review করবে।</p>
          </details>
        </div>
        <p class="coverage-reward-copy">
          <span data-i18n="coverageRewardBefore">আপনার suggested এলাকা যদি আমরা service coverage-এ যুক্ত করি, তাহলে ধন্যবাদ উপহার হিসেবে পাবেন</span>
          <strong class="coverage-reward-amount">+<%= coverageRewardAmount %>tk</strong>
          <span data-i18n="coverageRewardAfter">।</span>
        </p>
      </div>
      <a class="btn-main hover-trigger" href="/contact?topic=coverage#coverage-request" data-i18n="coverageRequestButton">কভারেজ রিকোয়েস্ট করুন</a>
    </div>
  </div>
</section>

<section class="join-path-section" id="join">
  <div class="sec-title gs-fade">
    <p class="eyebrow" data-i18n="joinEyebrow">আপনার Foodbela পথ বেছে নিন</p>
    <h2 data-i18n="joinTitle">আপনি কীভাবে Foodbela-তে যুক্ত হতে চান?</h2>
    <p data-i18n="joinCopy">খাবার অর্ডার, রেস্টুরেন্ট বড় করা বা রাইডার হিসেবে আয়—Foodbela-তে প্রত্যেকের জন্য আলাদা, পরিষ্কার ও দ্রুত পথ আছে।</p>
  </div>
  <div class="join-grid">
    <a class="join-card hover-trigger gs-fade" href="/download">
      <span>📱</span>
      <strong data-i18n="joinCustomerTitle">আমি খাবার অর্ডার করতে চাই</strong>
      <p data-i18n="joinCustomerCopy">কাছের রেস্টুরেন্ট, অফার, লাইভ ট্র্যাকিং ও সাপোর্ট—সব এক অ্যাপে।</p>
    </a>
    <a class="join-card hover-trigger gs-fade" href="<%= websiteSettings.restaurantApplyUrl || '/restaurants#apply' %>">
      <span>🍽️</span>
      <strong data-i18n="joinRestaurantTitle">আমি রেস্টুরেন্ট পার্টনার হতে চাই</strong>
      <p data-i18n="joinRestaurantCopy">অনলাইন অর্ডার, প্রচারণা সহায়তা, মেন্যু সেটআপ ও পরিষ্কার পেমেন্ট হিসাব।</p>
    </a>
    <a class="join-card hover-trigger gs-fade" href="<%= websiteSettings.riderApplyUrl || '/riders#apply' %>">
      <span>🛵</span>
      <strong data-i18n="joinRiderTitle">আমি রাইডার হিসেবে যুক্ত হতে চাই</strong>
      <p data-i18n="joinRiderCopy">নিজের এলাকায় ফ্লেক্সিবল সময়, পরিষ্কার পিকআপ নির্দেশনা ও ডেলিভারি আয়ের সুযোগ।</p>
    </a>
  </div>
</section>

