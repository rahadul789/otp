<!doctype html>
<html lang="bn">
  <head>
    <%
      const seoData = typeof seo !== "undefined" && seo ? seo : {};
      const pageTitle = seoData.title || title || "Foodbela";
      const pageDescription = seoData.description || description || "Foodbela food delivery, restaurant partners, and rider onboarding.";
      const canonicalUrl = seoData.canonicalUrl || "";
      const ogImageUrl = seoData.ogImageUrl || "/images/foodbela-og.png";
      const robotsContent = seoData.robots || "index,follow";
    %>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="<%= pageDescription %>" />
    <meta name="robots" content="<%= robotsContent %>" />
    <meta name="theme-color" content="#FFB84C" />
    <% if (seoData.googleSiteVerification) { %>
      <meta name="google-site-verification" content="<%= seoData.googleSiteVerification %>" />
    <% } %>
    <title><%= pageTitle %></title>
    <% if (canonicalUrl) { %>
      <link rel="canonical" href="<%= canonicalUrl %>" />
    <% } %>
    <meta property="og:site_name" content="<%= seoData.siteName || 'Foodbela' %>" />
    <meta property="og:type" content="<%= seoData.ogType || 'website' %>" />
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta property="og:description" content="<%= pageDescription %>" />
    <% if (canonicalUrl) { %>
      <meta property="og:url" content="<%= canonicalUrl %>" />
    <% } %>
    <meta property="og:image" content="<%= ogImageUrl %>" />
    <meta property="og:locale" content="<%= seoData.locale || 'bn_BD' %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= pageTitle %>" />
    <meta name="twitter:description" content="<%= pageDescription %>" />
    <meta name="twitter:image" content="<%= ogImageUrl %>" />
    <meta name="application-name" content="Foodbela" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/images/Foodbela.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;600;800;900&family=Outfit:wght@300;400;600;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/main.css" />
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
      defer
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
      defer
    ></script>
    <% if (seoData.structuredDataJson) { %>
      <script type="application/ld+json"><%- seoData.structuredDataJson %></script>
    <% } %>
  </head>
  <body>
    <div class="cursor-dot" id="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-outline" id="cursor-outline" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <%- include("nav") %>
    <main id="main">
