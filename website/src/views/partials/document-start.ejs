<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="<%= description %>" />
    <meta name="theme-color" content="#FFB84C" />
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/images/foodbela.svg" />
    <link rel="apple-touch-icon" href="/images/foodbela.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;600;800;900&family=Outfit:wght@300;400;600;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/main.css" />
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
      defer
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
      defer
    ></script>
  </head>
  <body>
    <div class="cursor-dot" id="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-outline" id="cursor-outline" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <%- include("nav") %>
    <main id="main"></main>
  </body>
</html>
