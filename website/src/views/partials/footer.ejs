<%
  const displayYear = typeof currentYear !== "undefined" ? currentYear : new Date().getFullYear();
  const cleanSocialUrl = (url) => {
    const value = String(url || "").trim();
    return value && value !== "#" ? value : "";
  };
  const footerSocialLinkItems = [
    {
      key: "facebook",
      label: "Facebook",
      url: cleanSocialUrl(websiteSettings.facebookUrl),
      icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 8.4V6.8c0-.8.5-1 1-1h1.5V3.1c-.7-.1-1.5-.2-2.2-.2-2.3 0-3.9 1.4-3.9 4v1.5H8v3h2.6V21h3.1v-9.6h2.6l.4-3h-3Z"/></svg>',
    },
    {
      key: "linkedin",
      label: "LinkedIn",
      url: cleanSocialUrl(websiteSettings.linkedinUrl),
      icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.8 9.2H3.7V21h3.1V9.2ZM5.2 3a1.8 1.8 0 1 0 0 3.6A1.8 1.8 0 0 0 5.2 3Zm15.1 11.2c0-3.2-1.7-5.3-4.6-5.3-1.8 0-2.9 1-3.4 1.9h-.1V9.2h-3V21h3.1v-5.8c0-1.5.3-3 2.2-3 1.8 0 1.8 1.7 1.8 3.1V21h3.1v-6.8Z"/></svg>',
    },
    {
      key: "tiktok",
      label: "TikTok",
      url: cleanSocialUrl(websiteSettings.tiktokUrl),
      icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.8 3c.3 2.2 1.6 3.7 3.7 3.9v3.1a7 7 0 0 1-3.7-1.1v5.8c0 3.6-2.4 6.3-6 6.3A5.8 5.8 0 0 1 5 15.2c0-3.4 2.7-5.9 6.2-5.7v3.2c-1.6-.2-3 .8-3 2.5a2.6 2.6 0 0 0 2.6 2.7c1.6 0 2.7-1 2.7-3.1V3h3.3Z"/></svg>',
    },
    {
      key: "youtube",
      label: "YouTube",
      url: cleanSocialUrl(websiteSettings.youtubeUrl),
      icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.6 4.6 12 4.6 12 4.6s-5.6 0-7.5.5a3 3 0 0 0-2.1 2.1C2 9 2 12 2 12s0 3 .4 4.8a3 3 0 0 0 2.1 2.1c1.9.5 7.5.5 7.5.5s5.6 0 7.5-.5a3 3 0 0 0 2.1-2.1c.4-1.8.4-4.8.4-4.8s0-3-.4-4.8ZM10 15.4V8.6l5.8 3.4-5.8 3.4Z"/></svg>',
    },
    {
      key: "instagram",
      label: "Instagram",
      url: cleanSocialUrl(websiteSettings.instagramUrl),
      icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.8 3h8.4A4.8 4.8 0 0 1 21 7.8v8.4a4.8 4.8 0 0 1-4.8 4.8H7.8A4.8 4.8 0 0 1 3 16.2V7.8A4.8 4.8 0 0 1 7.8 3Zm0 3A1.8 1.8 0 0 0 6 7.8v8.4A1.8 1.8 0 0 0 7.8 18h8.4a1.8 1.8 0 0 0 1.8-1.8V7.8A1.8 1.8 0 0 0 16.2 6H7.8Zm4.2 2.1a3.9 3.9 0 1 1 0 7.8 3.9 3.9 0 0 1 0-7.8Zm0 2.4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm4.3-2.8a1 1 0 1 1 0 2.1 1 1 0 0 1 0-2.1Z"/></svg>',
    },
    {
      key: "snapchat",
      label: "Snapchat",
      url: cleanSocialUrl(websiteSettings.snapchatUrl),
      icon: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2c2.7 0 4.5 1.8 4.5 4.8v2.7c0 .4.2.6.6.8l1.3.5c.5.2.6.9.1 1.2l-1.6 1c-.5.3-.8.7-.9 1.3-.2 1.2-1.2 2.1-2.4 2.1-.4 0-.8.1-1.1.4l-.5.5-.5-.5c-.3-.3-.7-.4-1.1-.4-1.2 0-2.2-.9-2.4-2.1-.1-.6-.4-1-.9-1.3l-1.6-1c-.5-.3-.4-1 .1-1.2l1.3-.5c.4-.2.6-.4.6-.8V8c0-3 1.8-4.8 4.5-4.8Z"/></svg>',
    },
  ];
  const defaultSocialOrder = ["facebook", "instagram", "youtube", "linkedin", "tiktok", "snapchat"];
  const requestedSocialOrder = Array.isArray(websiteSettings.socialLinksOrder)
    ? websiteSettings.socialLinksOrder
    : defaultSocialOrder;
  const normalizedSocialOrder = [...requestedSocialOrder, ...defaultSocialOrder].reduce((order, key) => {
    const normalizedKey = String(key || "").trim().toLowerCase();
    if (!defaultSocialOrder.includes(normalizedKey) || order.includes(normalizedKey)) return order;
    order.push(normalizedKey);
    return order;
  }, []);
  const footerSocialLinks = normalizedSocialOrder
    .map((key) => footerSocialLinkItems.find((item) => item.key === key))
    .filter((item) => item && item.url);
%>

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-brand">
      <a class="logo footer-logo hover-trigger" href="/">
        <span class="logo-mark logo-mark-image" aria-hidden="true">
          <img src="/images/Foodbela.svg" alt="" />
        </span>
        <span class="logo-word"
          ><span class="logo-food">Food</span><span class="logo-bela">bela</span
          ><span class="logo-dot">.</span></span
        >
      </a>
      <p data-i18n="footerCopy">
        লোকাল ক্রেভিং, ব্যস্ত কিচেন এবং শহরকে সচল রাখা রাইডারদের জন্য তৈরি একটি
        ফুড ডেলিভারি ইকোসিস্টেম।
      </p>
    </div>

    <div class="footer-column">
      <h2 data-i18n="footerExplore">এক্সপ্লোর</h2>
      <a href="/" data-i18n="navHome">হোম</a>
      <a href="/restaurants" data-i18n="navRestaurant">রেস্টুরেন্ট</a>
      <a href="/riders" data-i18n="navRider">রাইডার</a>
      <a href="/areas">সার্ভিস এলাকা</a>
      <a href="/about" data-i18n="navAbout">আমাদের সম্পর্কে</a>
    </div>

    <div class="footer-column">
      <h2 data-i18n="footerPartner">পার্টনার</h2>
      <a href="/restaurants#apply" data-i18n="restaurantOnboarding"
        >রেস্টুরেন্ট অনবোর্ডিং</a
      >
      <a href="/riders#apply" data-i18n="riderOnboarding">রাইডার অনবোর্ডিং</a>
      <a href="/contact" data-i18n="support">সাপোর্ট</a>
    </div>

    <div class="footer-column">
      <h2 data-i18n="navContact">যোগাযোগ</h2>
      <a href="mailto:<%= websiteSettings.supportEmail || site.email %>"
        ><%= websiteSettings.supportEmail || site.email %></a
      >
      <% if (footerSocialLinks.length) { %>
        <div class="footer-socials" aria-label="Foodbela social links">
          <% footerSocialLinks.forEach((item) => { %>
            <a
              class="footer-social-link social-<%= item.key %>"
              href="<%= item.url %>"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="<%= item.label %>"
              title="<%= item.label %>"
            ><%- item.icon %></a>
          <% }) %>
        </div>
      <% } %>
      <a
        class="footer-phone"
        href="tel:<%= (websiteSettings.supportPhone || site.phone).replace(/\s+/g, '') %>"
        ><%= websiteSettings.supportPhone || site.phone %></a
      >
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; <%= displayYear %> Foodbela. All rights reserved.</span>
    <span data-i18n="footerBottom"
      >ফ্রেশ ফুড। ক্লিয়ার অপস। আরও ভালো ডেলিভারি।</span
    >
  </div>
</footer>
