{
  "name": "foodbela-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready backend scaffold for the Foodbela multi-app ecosystem",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "seed": "tsx src/scripts/seed.ts",
    "seed:owners-showcase": "tsx src/scripts/seed-owner-showcase.ts",
    "perf:seed": "tsx scripts/perf-seed.ts",
    "seed:showcase": "tsx scripts/reset-showcase-seed.ts --seed-only",
    "db:reset-showcase": "tsx scripts/reset-showcase-seed.ts",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [
    "foodbela",
    "express",
    "mongodb",
    "socket.io",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.7.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.37.0",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
