NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_AUTH_TOKEN=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
TRUST_PROXY_HOPS=0
SERVICE_AREAS_ENABLED=true

MONGODB_URI=mongodb+srv://ATLAS_USERNAME:ATLAS_PASSWORD@ATLAS_CLUSTER_HOST/foodbela?retryWrites=true&w=majority

CLIENT_ORIGIN=http://localhost:5173
CUSTOMER_APP=http://192.168.1.2:8081
DELIVERY_APP=http://192.168.1.2:8082
ADMIN_PANEL_ORIGIN=http://localhost:5174
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3650d
ADMIN_BOOTSTRAP_EMAIL=admin@foodbela.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@123456
ADMIN_BOOTSTRAP_NAME=Foodbela Admin
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_AUTH_COOKIE_SECURE=false
ADMIN_AUTH_COOKIE_SAME_SITE=lax
OWNER_AUTH_COOKIE_SECURE=false
OWNER_AUTH_COOKIE_SAME_SITE=lax
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=demo-key
CLOUDINARY_API_SECRET=demo-secret
BACKEND_PUBLIC_URL=http://localhost:5000
BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
MOCK_OTP_ENABLED=true
MOCK_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_API_URL=https://api.sms.net.bd/sendsms
SMS_API_KEY=your_smsbd_api_key
SMS_SENDER_ID=

ALERTS_ENABLED=false
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=30
ALERT_RECIPIENT_EMAILS=admin@foodbela.com
ALERT_FROM_EMAIL=alerts@foodbela.com
ALERT_FROM_NAME=Foodbela Monitor
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerts@foodbela.com
SMTP_PASS=your_hostinger_email_password
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_SYSTEM_BOT_TOKEN=
TELEGRAM_SYSTEM_CHAT_ID=
ALERT_BACKEND_HEALTH_URL=https://api.foodbela.com/api/v1/health/ready
ALERT_METRICS_URL=http://backend:5000/metrics
ALERT_SSL_HOSTS=foodbela.com,www.foodbela.com,api.foodbela.com,owner.foodbela.com,admin.foodbela.com
ALERT_SSL_EXPIRY_DAYS=14
ALERT_MEMORY_RSS_MB=900
ALERT_CPU_PERCENT=85
ALERT_5XX_THRESHOLD=5
ALERT_SMS_LOW_BALANCE=100
ALERT_REFUND_PENDING_MINUTES=120
ALERT_SUPPORT_SLA_OVERDUE_MINUTES=15
